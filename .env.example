# Copy this file to .env in the app's root directory, then run go run .
# The app reads .env from the current working directory at startup.
# Existing environment variables override values in .env. Restart after editing.
# Use KEY=value syntax. Lines starting with # are comments.

# Listening address: :8080 uses port 8080 on all network interfaces.
# Change the port here, e.g. ADDR=:3000.
# To accept connections only from this computer: ADDR=127.0.0.1:8080
ADDR=:8080

# Directory containing bracket.db and uploads/ (relative to the working directory).
DATA_DIR=./data

# Optional executables. Leave commented to find ffmpeg and ffprobe on PATH.
# Use single quotes for paths containing spaces or Windows backslashes.
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# FFMPEG_PATH='C:\Program Files\ffmpeg\bin\ffmpeg.exe'
# FFPROBE_PATH='C:\Program Files\ffmpeg\bin\ffprobe.exe'
